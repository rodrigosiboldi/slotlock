# Copy to .env (Bun loads it automatically). Production values live in the platform's settings.

# Postgres 15+ with btree_gist available (Neon, Supabase, RDS and the official image all have it).
# Serverless: use the pooled connection string. Migrations: set DIRECT_DATABASE_URL too.
DATABASE_URL=postgres://slotlock:slotlock@localhost:5432/slotlock
# DIRECT_DATABASE_URL=

# Master secret; encryption and signing keys are derived from it. At least 32 characters.
APP_SECRET=replace-with-a-long-random-string-0123456789

# Public origin, used in links and in the demo's webhook URL. Derived automatically on Vercel.
PUBLIC_URL=http://localhost:3000

# Optional
# METRICS_TOKEN=        # enables GET /metrics (Bearer token)
# CRON_SECRET=          # protects GET /internal/cron/daily (Vercel sends it)
# LOG_LEVEL=info        # debug | info | warn | error | silent
# DEMO_ENABLED=true     # the public demo page, races and webhook receiver
# DB_MAX_CONNECTIONS=10
